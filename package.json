{
  "name": "@ph0n/theme-kit",
  "version": "0.6.0",
  "description": "Shared themes, styles and Solid UI components for divizn's sites",
  "type": "module",
  "exports": {
    "./themes/*": "./themes/*",
    "./base.css": "./base.css",
    "./components.css": "./components.css",
    "./tailwind.css": "./tailwind.css",
    "./ui": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "themes",
    "base.css",
    "components.css",
    "tailwind.css",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-tokens",
    "tailwind",
    "css",
    "theme"
  ],
  "author": "Hassan Javed",
  "license": "MIT",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3"
  }
}
